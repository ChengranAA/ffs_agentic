{
  "name": "@local/ffs-analysis-ui",
  "version": "0.1.63",
  "private": true,
  "type": "module",
  "description": "FFS analysis inspection tab for DeepSeek Harness: pipeline, artifacts, QC, results, cohort and group views",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "docs",
    "icon.svg",
    "fixtures",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
