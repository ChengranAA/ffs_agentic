{
  "name": "@local/ffs-harness-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Docked, tabbed FFS fMRI viewer workspace for the DeepSeek Harness right Sidebar",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "logo.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
